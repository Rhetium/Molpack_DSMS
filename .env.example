# Copiar a `.env` y completar. `.env` NO se versiona (ver .gitignore).
# En el servidor: chmod 600 .env

# --- PostgreSQL (requerido) ---
# DB_USER, DB_PASSWORD y DB_NAME no tienen valor por defecto:
# si faltan, la URL de conexion se arma con "None" y el arranque falla.
DB_USER=
DB_PASSWORD=
DB_NAME=
# Con docker compose, DB_HOST/DB_PORT los fija el propio compose (servicio "db"):
# el valor de aqui solo se usa al correr la app fuera de contenedores.
DB_HOST=localhost
DB_PORT=5432
# true imprime todo el SQL ejecutado (incluidos los valores) en los logs.
# Dejar en false en produccion.
DB_ECHO=false

# --- Despliegue con Docker ---
# Los valores de abajo son los del perfil "tls", que es como se despliega:
# nginx publica el 80 y el 443, y la app solo escucha en loopback.
#
# Puerto y interfaz donde queda publicada la app. Con el perfil "tls" esto
# es solo para depurar desde el propio host (curl localhost:8000): quien
# atiende a los usuarios es nginx. Sin el perfil, 0.0.0.0 deja la app en
# HTTP plano sobre la red, que es lo que no queremos.
APP_PORT=8000
APP_BIND=127.0.0.1
# De quien acepta uvicorn la cabecera X-Forwarded-For (la IP real del usuario,
# que es la que cuenta el rate limiter de login). El "*" es correcto aca:
# nginx llega con una IP dinamica de la red de Compose y, con APP_BIND en
# loopback, nadie mas puede alcanzar la app para falsificar la cabecera.
FORWARDED_ALLOW_IPS=*

# --- JWT ---
# Generar uno propio: python -c "import secrets; print(secrets.token_hex(32))"
# Si se deja vacio, el codigo usa un secreto de desarrollo conocido y los
# tokens pasan a ser falsificables.
JWT_SECRET=
JWT_EXPIRATION_HOURS=8

# --- Autenticacion local ---
# Usuarios embebidos en el codigo (admin/admin, demo/demo) para trabajar sin
# un Domain Controller. Sin definir, se apagan solos cuando LDAP queda
# configurado. Ponerlo en "true" con LDAP activo los reabre: es una palanca de
# emergencia, no configuracion permanente.
AUTH_LOCAL_HABILITADO=false

# --- LDAP / Active Directory ---
# Dominio: molpack.org. Si LDAP_SERVER o LDAP_BASE_DN quedan vacios, LDAP se
# considera deshabilitado y la autenticacion cae a los usuarios locales.
# Ejemplo:
#   LDAP_SERVER=ldaps://<dc>.molpack.org:636
#   LDAP_BASE_DN=DC=molpack,DC=org
#   LDAP_BIND_DN=CN=<cuenta servicio>,OU=<ou>,DC=molpack,DC=org
#   LDAP_GRUPO_AUTORIZADO=CN=DSMS_Users,OU=<ou>,DC=molpack,DC=org
LDAP_SERVER=
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_GRUPO_AUTORIZADO=
LDAP_USER_FILTER=(sAMAccountName={username})
# true al usar ldaps:// en el puerto 636. Requiere que el certificado del DC
# sea confiable en el host.
LDAP_USE_SSL=false

# --- Embeddings ---
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
