--- PASO 4: Disparar el motor sobre la ficha B y capturar el SQL emitido ---
  HTTP 200 PATCH /api/ficha/df0c6e27-ee40-470e-9b2e-63ef1ec09f04
  {
    "id_ficha": "df0c6e27-ee40-470e-9b2e-63ef1ec09f04",
    "estado_ficha": "Borrador"
  }

  Consultas SQL emitidas durante el analisis: 38
  De ellas, con operador de distancia coseno de pgvector (<=>): 2

  SELECT kitem.id, kitem.ktype, kitem.nombre, kitem.descripcion, kitem.estado, kitem.metadata_extra, kitem.embedding, kitem.usuario_creador, kitem.usuario_ultima_actualizacion, kitem.fecha_creacion, kitem.fecha_actualizacion, $1::INTEGER - (kitem.embedding <=> $2) AS similitud FROM kitem WHERE kitem.embedding IS NOT NULL AND kitem.id != $3::UUID AND kitem.ktype = $4::VARCHAR ORDER BY (kitem.embedding <=> $2) ASC LIMIT $5::INTEGER

  SELECT kitem.id, kitem.ktype, kitem.nombre, kitem.descripcion, kitem.estado, kitem.metadata_extra, kitem.embedding, kitem.usuario_creador, kitem.usuario_ultima_actualizacion, kitem.fecha_creacion, kitem.fecha_actualizacion, $1::INTEGER - (kitem.embedding <=> $2) AS similitud FROM kitem WHERE kitem.embedding IS NOT NULL AND kitem.ktype = $3::VARCHAR ORDER BY (kitem.embedding <=> $2) ASC LIMIT $4::INTEGER

