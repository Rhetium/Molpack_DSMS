# Entornos virtuales de Python
.venv/
venv/
env/

# Bytecode de Python
__pycache__/
*.py[cod]

# Pruebas
.pytest_cache/
.coverage
htmlcov/

# Secretos y configuración local — NUNCA commitear credenciales
.env
.env.*
!.env.example

# Modelos ML entrenados (se regeneran con POST /anomalias/entrenar)
app/ml_models/*.pkl
app/ml_models/*.joblib

# Respaldos de base de datos (pg_dump)
backups/

# Frontend
frontend/node_modules/
frontend/dist/

# Editor / SO
.vscode/
.idea/
Thumbs.db
.DS_Store

# Claves SSH: nunca deben vivir en el repositorio (van en ~/.ssh)
id_ed25519*
id_rsa*
*.pem

# Certificados TLS del servidor: se generan en la VM, no se versionan.
deploy/certs/*
!deploy/certs/README.md
*.crt
*.key
*.csr
