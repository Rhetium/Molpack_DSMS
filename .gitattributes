*.dll filter=lfs diff=lfs merge=lfs -text

# Archivos que ejecuta Linux: con finales CRLF, el shell no encuentra el
# interprete ("bad interpreter") y el contenedor no arranca. Se versionan y
# se extraen siempre con LF, aunque el clon sea en Windows.
*.sh        text eol=lf
Dockerfile  text eol=lf
*.conf      text eol=lf
*.sql       text eol=lf
